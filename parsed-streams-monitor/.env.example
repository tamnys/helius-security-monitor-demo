RPC_URL=https://api.devnet.solana.com
DEPLOYER_KEYPAIR=
PROGRAM_KEYPAIR=
COLLATERAL_PROGRAM_ID=
COLLATERAL=
# All signing files must live outside the repository.
CUSTOMER_KEYPAIR=
ATTACKER_KEYPAIR=
BOT_KEYPAIR=
DB_PATH=./run/parsed-streams.sqlite

# Devnet uses the local protocol fixture because Helius Parsed Streams and
# Parsed Events are documented on mainnet endpoints.
STREAM_MODE=fixture
STREAM_URL=ws://127.0.0.1:3100
FIXTURE_PORT=3100

# Mainnet production mode and the read-only live service smoke test.
PARSED_EVENTS_URL=https://mainnet.helius-rpc.com/v1/parsed-events/transaction-history
HELIUS_API_KEY=
SMOKE_TIMEOUT_MS=60000
